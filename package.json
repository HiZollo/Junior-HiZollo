{
  "name": "junior-hizollo",
  "version": "1.4.0",
  "description": "用 TypeScript 寫成的爛 bot",
  "main": "dist/src/index.js",
  "private": true,
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "tsc-watch --onSuccess resolve-tspaths",
    "build": "tsc",
    "postbuild": "resolve-tspaths",
    "deploy": "npx dotenv run -- node dist/src/deploy.js",
    "rg-webhook": "npx dotenv run node dist/src/register-webhook.js",
    "start": "npx dotenv run node dist/src/index.js",
    "test": "npx dotenv run node dist/src/index.js dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiZollo/Junior-HiZollo.git"
  },
  "keywords": [
    "HiZollo"
  ],
  "author": "HiZollo Organization",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/HiZollo/Junior-HiZollo/issues"
  },
  "homepage": "https://github.com/HiZollo/Junior-HiZollo#readme",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@hizollo/calculator": "^1.1.1",
    "@hizollo/games": "^3.0.0-beta.0",
    "@hizollo/osu-api": "^1.2.1",
    "axios": "^1.21.0",
    "discord.js": "^14.28.0",
    "dotenv": "^18.0.9",
    "emoji-regex": "^11.0.0",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "play-dl": "^1.9.7",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "resolve-tspaths": "^0.8.23",
    "tsc-watch": "^7.2.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
